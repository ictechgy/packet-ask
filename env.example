# packet-ask 는 .env 를 자동으로 읽지 않습니다.
# 값을 채운 파일을 커밋하지 마세요. 셸에서 export 하거나 세션 환경에만 두세요.
# 명령줄에 키 값을 적으면 셸 히스토리에 남습니다.

# GLM Coding Plan 키. 전역 Anthropic 키를 쓰지 마세요.
# PACKET_ASK_GLM_KEY=

# Kimi 키. config.toml 에 쓰지 않습니다.
# PACKET_ASK_KIMI_KEY=

# Anthropic Claude 서브 키. 전역 ANTHROPIC_API_KEY 를 쓰지 마세요.
# PACKET_ASK_CLAUDE_KEY=

# 패킷 캐시 디렉터리. 비우면 OS 캐시를 씁니다.
# PACKET_ASK_CACHE_DIR=

# 공식 claude/kimi 절대경로. 비우면 신뢰 디렉터리에서 찾습니다.
# PACKET_ASK_CLAUDE_BIN=
# PACKET_ASK_KIMI_BIN=

# 신뢰 실행 디렉터리 추가. os.pathsep 으로 구분한 절대경로만 유효합니다.
# PACKET_ASK_BIN_DIRS=

# 기본 추론 effort. low, medium, high, xhigh, max 중 하나.
# --effort 가 이깁니다. 오타는 조용히 무시되지 않고 거절됩니다.
# glm 과 claude 만 받습니다. paste 와 kimi 는 거절합니다.
# PACKET_ASK_EFFORT=
